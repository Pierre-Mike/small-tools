{
  "name": "small-tools",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "dev": "axioms dev",
    "check": "axioms check",
    "smoke": "axioms smoke",
    "slice": "axioms slice",
    "lint": "axioms biome check --write .",
    "deploy": "axioms deploy",
    "deploy:dry": "axioms deploy --dry-run",
    "ci:dry": "axioms ci-dry-run --all",
    "prepare": "axioms hooks"
  },
  "devDependencies": {
    "@pierre-mike/axioms": "github:Pierre-Mike/factory#v0.13.0"
  }
}
