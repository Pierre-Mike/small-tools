{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "small-tools",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The web app is served from Workers static assets; only /api/* reaches the worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "small-tools",
      "database_id": "5424c62f-bab9-49d4-8c82-7b8152103115",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "APP_VERSION": "0.0.0", "ENVIRONMENT": "production" }
}
